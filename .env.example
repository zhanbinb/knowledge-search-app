APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8000

AGENT_MODEL=mimo-v2.6-flash
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1200
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

SILICONFLOW_API_KEY=replace_me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

CHUNK_SIZE=800
CHUNK_OVERLAP=120
BM25_CANDIDATE_COUNT=20
VECTOR_CANDIDATE_COUNT=20
RRF_K=60
RERANK_CANDIDATE_COUNT=20
FINAL_CONTEXT_COUNT=5
RERANK_SCORE_THRESHOLD=0.15

MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=10
MAX_TOOL_CALLS=5
MAX_UPLOAD_SIZE_MB=10

MCP_ENABLED=true
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=run,mcp_server/server.py
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
